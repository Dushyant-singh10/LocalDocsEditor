# Shared across apps/web and apps/sync-server — both connect to the same Postgres.
# Use Neon's *pooled* connection string here for apps/web (short-lived serverless
# functions) and the *unpooled/direct* string for apps/sync-server (long-lived process).
DATABASE_URL=postgres://user:password@localhost:5432/local_first_docs

# Optional: a separate, disposable database for packages/db's integration
# tests (never your dev DB — see packages/db/src/test-utils.ts).
TEST_DATABASE_URL=

# --- apps/web ---
AUTH_SECRET=                     # openssl rand -base64 33
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
REALTIME_JWT_SECRET=             # shared with apps/sync-server — openssl rand -base64 33
NEXT_PUBLIC_SYNC_SERVER_URL=ws://localhost:1234
SYNC_SERVER_INTERNAL_URL=http://localhost:1234
INTERNAL_SYNC_SECRET=            # shared with apps/sync-server — openssl rand -base64 33
GEMINI_API_KEY=                  # aistudio.google.com/apikey — used by @ai-sdk/google
GMAIL_USER=                      # a real Gmail address used to relay invite emails via SMTP
GMAIL_APP_PASSWORD=              # myaccount.google.com/apppasswords (needs 2-Step Verification on)

# --- apps/sync-server ---
# PORT is injected automatically on Render; defaults to 1234 locally.
# DATABASE_URL, REALTIME_JWT_SECRET, INTERNAL_SYNC_SECRET as above.
# Both the realtime websocket and the internal snapshot/restore API are
# served from this same port (see apps/sync-server/src/index.ts).
